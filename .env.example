# ── 数据库 ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance"

# ── 鉴权 / 加密 ─────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# KMS 主密钥：加密用户私钥密文的密钥加密密钥（生产请用强随机值）
SM_KEK="change-this-key-encryption-key"

# ── 服务 ────────────────────────────────────────────────
PORT=3000

# Admin 发版管理（GitHub fine-grained token 仅需 finance-app Actions 读写权限）
GITHUB_RELEASE_TOKEN=""
GITHUB_RELEASE_OWNER="vic-vic-yang"
GITHUB_RELEASE_REPO="finance-app"
GITHUB_RELEASE_WORKFLOW="release.yml"
GITHUB_RELEASE_BRANCH="main"
# 允许的跨域来源（逗号分隔），留空表示按默认策略
CORS_ORIGINS=""

# ── LLM 槽位（OpenAI 兼容，最多 20 个）─────────────────────
# 每个模型 3 行，复制改编号即可加新模型
LLM_1_URL="https://api.deepseek.com"
LLM_1_KEY="sk-xxx"
LLM_1_MODEL="deepseek-v4-flash"
# 视觉能力默认按模型名识别；可显式覆盖：
# LLM_1_VISION="false"
# 默认文本 / 视觉模型名（可选）
# AI_DEFAULT_TEXT_MODEL="deepseek-v4-flash"
# AI_DEFAULT_VISION_MODEL=""

# 账本共享 LLM Key 的加密密钥（AES-256-GCM），缺省回落 JWT_SECRET
# LLM_CONFIG_SECRET=""

# 注：早期「财经资讯 agent」已移除，NEWS_* 相关变量不再被读取。
