# ── 数据库 ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance"

# ── 鉴权 / 加密 ─────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# KMS 主密钥：加密用户私钥密文的密钥加密密钥（生产请用强随机值）
SM_KEK="change-this-key-encryption-key"

# ── 服务 ────────────────────────────────────────────────
PORT=3000
# 允许的跨域来源（逗号分隔），留空表示按默认策略
CORS_ORIGINS=""

# ── LLM 槽位（OpenAI 兼容，最多 20 个）─────────────────────
# 每个模型 3 行，复制改编号即可加新模型
LLM_1_URL="https://api.deepseek.com"
LLM_1_KEY="sk-xxx"
LLM_1_MODEL="deepseek-v4-flash"
# 视觉能力默认按模型名识别；可显式覆盖：
# LLM_1_VISION="false"
# 默认文本 / 视觉模型名（可选）
# AI_DEFAULT_TEXT_MODEL="deepseek-v4-flash"
# AI_DEFAULT_VISION_MODEL=""

# ── 财经资讯（均可选，有默认值）──────────────────────────
# 覆盖默认 RSS 源列表（逗号分隔）
# NEWS_RSS_FEEDS=""
# 关闭新闻 LLM 富化（省 token），默认开
# NEWS_USE_LLM="true"
# 关闭入库后全文分析，默认开
# NEWS_ANALYZE_AT_INGEST="true"
# 每轮补齐全文分析的条数上限，默认 200
# NEWS_ANALYZE_LIMIT="200"
