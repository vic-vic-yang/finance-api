generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillType {
  income
  expense
}

enum AccountType {
  CASH // 现金
  BANK // 银行卡（储蓄卡/借记卡/存折）
  VIRTUAL // 虚拟账户（微信/支付宝/电子钱包等）
  CREDIT // 信用卡
  INVESTMENT // 投资理财（理财 / 股票 / 基金 / 债券）
  INSURANCE // 社保（社保 / 公积金 / 保险）
  DEBT // 负债账户（房贷 / 车贷 / 借款）
  OTHER // 其他
  // ─── 历史保留（PG 不能干净地删 enum 值，仅用于读取旧数据）───
  ALIPAY
  WECHAT
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum LedgerRole {
  owner
  member
}

enum AiImportStatus {
  pending // 已上传，待处理
  extracting // 提取文件内容（OCR / 解 CSV / 读 PDF）
  parsing // LLM 解析中
  dedupping // 去重中
  review_ready // 草稿就绪，等客户端拉取加密入库
  applying // 客户端正在批量加密入库
  done
  failed
  partial // 部分成功
}

model User {
  id              String         @id @default(cuid())
  username        String         @unique
  /// 用户昵称，显示用；为空时回退到 username
  nickname        String?
  password        String
  createdAt       DateTime       @default(now())
  currentLedgerId String? // 当前活动账本
  currentLedger   Ledger?        @relation("CurrentLedger", fields: [currentLedgerId], references: [id], onDelete: SetNull)
  ownedLedgers    Ledger[]       @relation("OwnedLedgers")
  ledgerMembers   LedgerMember[]
  bills           Bill[] // 创建者，便于追踪是谁记的
  categories      Category[] // 用户自建分类（系统分类 userId=null）
  ownedAccounts   Account[]      @relation("AccountOwner")
  aiImports       AiImport[]     @relation("UserAiImports")

  // ── 国密 SM2 用户密钥对（端到端加密基础）───────────────────
  /// SM2 公钥（hex 字符串，未压缩 04|x|y 共 130 个字符）
  sm2PubKey         String?
  /// SM2 私钥用 KDF(密码) 派生的 SM4 密钥加密后的字节流（iv||ct||mac）
  sm2PrivByPwd      Bytes?
  /// SM2 私钥用 KDF(恢复码) 派生的 SM4 密钥加密后的字节流（找回密钥用）
  sm2PrivByRecovery Bytes?
  /// 派生 KEK 用的 salt（密码 + 恢复码共用同一个 salt，简化客户端逻辑）
  kdfSalt           Bytes?
  /// 恢复码 SM3(code || salt) 哈希，用于"忘密码 → 验证恢复码"
  recoveryHash      Bytes?
}

model Ledger {
  id         String          @id @default(cuid())
  name       String
  icon       String? // emoji
  ownerId    String
  owner      User            @relation("OwnedLedgers", fields: [ownerId], references: [id], onDelete: Cascade)
  isPersonal Boolean         @default(false) // true=个人默认账本，不可删除/退出
  createdAt  DateTime        @default(now())
  members    LedgerMember[]
  invites    LedgerInvite[]
  accounts   Account[]
  bills      Bill[]
  budgets    Budget[]
  categories Category[]
  currentFor User[]          @relation("CurrentLedger")
  aiImports  AiImport[]      @relation("LedgerAiImports")
  recurring  RecurringBill[]
  proposals  Proposal[]

  @@index([ownerId])
}

model LedgerMember {
  id       String     @id @default(cuid())
  ledgerId String
  ledger   Ledger     @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     LedgerRole @default(member)
  joinedAt DateTime   @default(now())

  // ── 信封加密：该账本 DEK 用该成员公钥 SM2 包装后的密文 ──
  /// 包装后的 DEK；新成员通过邀请码加入后此处先为 null，
  /// 由任意已持有 DEK 的在线成员客户端检测到后自动 wrap & 上传
  dekWrapped Bytes?
  /// DEK 版本号，支持密钥轮换（v2 起所有成员需重新 wrap）
  dekVersion Int    @default(1)

  @@unique([ledgerId, userId])
  @@index([userId])
}

model LedgerInvite {
  id        String    @id @default(cuid())
  ledgerId  String
  ledger    Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  code      String    @unique
  createdBy String
  expiresAt DateTime
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ledgerId])
}

model Account {
  id         String          @id @default(cuid())
  ledgerId   String
  ledger     Ledger          @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  /// 账户所有者：null = 共享账户（账本内所有成员可用）；非空 = 私人账户（仅本人可见可用）
  ownerId    String?
  owner      User?           @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// 账户名密文（SM4-CBC + SM3-HMAC, iv||ct||mac 一体）。
  /// 服务端永不解密；客户端用账本 DEK 解。
  nameCipher Bytes
  /// 加密时使用的 DEK 版本（用于密钥轮换）
  nameDekVer Int             @default(1)
  type       AccountType
  balance    Decimal         @default(0) @db.Decimal(15, 2)
  /// 初始余额（建账时录入；老账户由 当前余额 − 历史净收支 回填）
  initialBalance Decimal     @default(0) @db.Decimal(15, 2)
  icon       String?
  color      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  bills      Bill[]
  recurring  RecurringBill[]
  goals      SavingsGoal[]

  // ── 信用卡专用 ─────────────────────────────────────────────
  /// 账单日（1-31）：每月这一天出账
  statementDay Int?
  /// 还款日（1-31）：每月这一天前需还款
  dueDay       Int?
  /// 信用额度（可选，仅信用卡使用，用于显示"已用 / 总额度"）
  creditLimit  Decimal? @db.Decimal(15, 2)

  // ── 负债账户专用 ──────────────────────────────────────────
  /// 年利率（%），如 5.4 表示 5.4%；dueDay 复用为月还款日
  interestRate     Decimal?  @db.Decimal(6, 3)
  /// 贷款本金（原始金额）
  loanPrincipal    Decimal?  @db.Decimal(15, 2)
  /// 贷款期限（月）
  loanTermMonths   Int?
  /// 首次还款日期（用于计算已还期数）
  firstPaymentDate DateTime?
  /// 还款方式：equal_payment(等额本息) / equal_principal(等额本金) / interest_only(先息后本)
  repaymentMethod  String?

  // ── 自动入账（社保 / 公积金 / 工资固定到账）专用 ─────────
  /// 每月自动入账日（1-31）
  autoDepositDay        Int?
  /// 每月自动入账金额
  autoDepositAmount     Decimal?  @db.Decimal(15, 2)
  /// 自动入账记入哪个分类（可选；为空时后端用"其他收入"系统分类）
  autoDepositCategoryId String?
  /// 自动入账上次处理到的日期（用于补漏，不依赖定时任务）
  lastAutoProcessedAt   DateTime?

  @@index([ledgerId])
  @@index([ownerId])
}

model Category {
  id        String   @id @default(cuid())
  ledgerId  String? // null = 系统分类（全局共享）
  ledger    Ledger?  @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId    String? // 创建者，便于审计；null 表示系统
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  type      BillType
  icon      String?
  color     String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  // —— 二级分类支持：parentId 为空 = 一级分类 ——
  parentId String?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryChildren")

  bills     Bill[]
  budgets   Budget[]
  recurring RecurringBill[]

  @@index([ledgerId])
  @@index([parentId])
}

model Bill {
  id         String   @id @default(cuid())
  ledgerId   String
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId     String // 记账人，多账本时显示"谁记的"
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  type       BillType
  amount     Decimal  @db.Decimal(15, 2)
  /// 备注密文（SM4-CBC + SM3-HMAC, iv||ct||mac 一体）。
  /// 空备注也加密为一个固定密文（避免空字段泄露"无备注"信息）
  noteCipher Bytes
  /// 加密所用 DEK 版本
  noteDekVer Int      @default(1)
  date       DateTime
  /// 平台交易订单号（支付宝/微信），用于同源稳健去重；非平台来源为 null
  externalId String?
  /// 来源渠道：alipay / wechat / bank / manual
  source     String   @default("manual")
  /// 是否为转账账单（账户间转账拆成的一收一支）。转账不计入收支统计/预算，但在账单列表可见。
  isTransfer Boolean  @default(false)
  /// 银行流水的「联机余额」（该笔交易后的账户余额）。仅银行类导入有；
  /// 用作高精度去重的天然唯一键，最新一笔还可用来校准账户余额。
  bankBalance Decimal? @db.Decimal(15, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ledgerId, date(sort: Desc)])
  @@index([ledgerId, externalId])
  @@index([ledgerId, accountId, date])
}

model AiImport {
  id       String @id @default(cuid())
  ledgerId String
  ledger   Ledger @relation("LedgerAiImports", fields: [ledgerId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("UserAiImports", fields: [userId], references: [id], onDelete: Cascade)

  // 文件
  filename String
  fileType String // image / pdf / csv / xlsx / text
  fileSize Int

  // 用户上传时选定的目标账户（所有解析出的草稿都入到这个账户）
  accountId String

  // AI 模型
  modelName String

  // 状态
  status   AiImportStatus @default(pending)
  progress Int            @default(0) // 0-100
  message  String? // 当前阶段说明或失败原因（简短）

  // 统计
  parsedCount   Int @default(0) // AI 解析出多少条
  dupCount      Int @default(0) // 去重跳过多少条
  insertedCount Int @default(0) // 实际入库多少条

  // 草稿 + 调试（明文暂存，apply 完成后清空）
  draftsJson String? // JSON 数组：[{ type, amount, categoryName, accountName, note, date }]
  rawOutput  String? // LLM 原始返回，方便排查
  errorTrace String? // 失败时的错误信息

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([ledgerId, status])
}

model Budget {
  id         String       @id @default(cuid())
  ledgerId   String
  ledger     Ledger       @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id])
  amount     Decimal      @db.Decimal(15, 2)
  period     BudgetPeriod
  startDate  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([ledgerId])
}

/// 周期账单（房租 / 会员订阅 / 话费 ...）
/// 可由 AI 从历史账单识别（isAuto=true）也可手动添加。
/// note 加密存储，沿用 Bill 的 noteCipher/noteDekVer 字段命名。
model RecurringBill {
  id         String   @id @default(cuid())
  ledgerId   String
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  type       BillType @default(expense)
  amount     Decimal  @db.Decimal(15, 2)
  /// 备注密文（同 Bill.noteCipher 格式）
  noteCipher Bytes?
  noteDekVer Int?
  /// monthly | weekly | yearly
  cycleType  String   @default("monthly")
  /// 几号（月度）或 周几（周度，1-7）或 mmdd（年度）
  cycleDay   Int
  /// 下次触发时间（服务器算）
  nextDate   DateTime
  isActive   Boolean  @default(true)
  /// true = AI 自动发现的候选；用户确认后置 false（变成手动维护）
  isAuto     Boolean  @default(false)
  /// 识别置信度 0-1
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ledgerId, isActive])
  @@index([nextDate])
}

/// 储蓄目标（独立模块，不属于 AI）。
/// name 加密；进度通过查询账单实时算（不冗余存储 currentSaved）
model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  ledgerId     String
  /// 目标名称密文（SM4-CBC + SM3-HMAC, iv||ct||mac）
  nameCipher   Bytes
  nameDekVer   Int       @default(1)
  targetAmount Decimal   @db.Decimal(15, 2)
  /// 起算日：从这天起的（收入-支出）算作已存（未绑定账户时使用）
  startDate    DateTime  @default(now())
  /// 绑定的账户：不为空时用账户余额自动计算进度
  accountId    String?
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// 绑定账户时的初始余额快照。为 0 = 计入现有余额；> 0 = 从零开始（只算增量）
  initialBalance Decimal? @db.Decimal(15, 2)
  /// 期望达成日（可空）
  deadline     DateTime?
  icon         String?
  color        String?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, ledgerId])
}

/// AI 洞察的"已忽略"记录。
/// 洞察本身实时计算，不长期持久化；只持久化"用户对某条洞察的忽略状态"。
/// 同 (type, target) 30 天内不再出现；过期后如果条件仍成立会再次浮出。
model AiInsightDismissal {
  id          String   @id @default(cuid())
  userId      String
  ledgerId    String
  /// anomaly_cat | anomaly_bill | budget_alert | recurring_due | trend_up | trend_down ...
  type        String
  /// 关联对象 id（categoryId / billId / budgetId / recurringId 等），不同 type 含义不同
  target      String
  dismissedAt DateTime @default(now())
  expireAt    DateTime

  @@unique([userId, ledgerId, type, target])
  @@index([userId, ledgerId])
  @@index([expireAt])
}

model Proposal {
  id             String    @id @default(cuid())
  ledgerId       String
  ledger         Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  type           String
  status         String    @default("pending") // pending|approved|dismissed|snoozed|done|expired
  severity       String    @default("warning") // info|warning|critical
  title          String
  body           String
  actionKind     String?
  actionParams   Json?
  requiresClient Boolean   @default(false)
  evidenceRefs   Json?
  dedupeKey      String
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@unique([ledgerId, dedupeKey])
  @@index([ledgerId, status])
}

model ProposalFeedback {
  id         String    @id @default(cuid())
  ledgerId   String
  type       String
  dismissed  Int       @default(0)
  approved   Int       @default(0)
  mutedUntil DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([ledgerId, type])
}

/// 每日财经新闻（全局，非账本相关；公开数据，不涉及加密隐私）。
/// 由 news 模块抓取 RSS 聚合 + 可选 LLM 排序/中文摘要后入库，按 url 去重。
model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  /// LLM 翻译的中文标题（列表/详情主标题用）；无 LLM 时回退原标题
  titleZh     String?
  /// LLM 中文摘要；无 LLM 时回退 RSS 原始描述
  summary     String?
  /// 来源名（CNBC / MarketWatch / 新浪财经 …）
  source      String
  /// 原文链接，唯一，用于跨日去重
  url         String   @unique
  imageUrl    String?
  /// 标签：股市 / 宏观 / 加密 / 科技 / 政策 …（LLM 给）
  category    String?
  /// 重要性评分 0-100（LLM 给，用于排序）；无 LLM 时按时间
  importance  Int      @default(0)
  /// 情绪：positive / neutral / negative（可选）
  sentiment   String?
  /// 抓取的原文正文（纯文本，懒加载：用户打开详情时才抓）
  content     String?
  /// LLM 基于正文提炼的要点分析（懒加载，打开详情时生成并缓存）
  analysis    String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([importance])
}

/// 用户查询过的股票分析快照（按用户隔离）。每次查询/更新存一条，
/// 列表按 symbol 取最新一条；分析时参考上一条做对比。公开行情数据，不加密。
model StockAnalysis {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  name      String?
  nameZh    String?
  /// 查询时的关键指标快照（价格/市值/PE/评级/目标价…）
  quote     Json
  /// LLM 分析文本
  analysis  String?
  /// 相关新闻快照
  news      Json?
  createdAt DateTime @default(now())

  @@index([userId, symbol, createdAt])
  @@index([userId, createdAt])
}

/// 借贷往来：借出(别人欠我/应收) 或 借入(我欠别人/应付)。本金走转账类账单不计收支。
/// 对方信息只在备注里（端到端加密），不单独建账户。
model Loan {
  id           String    @id @default(cuid())
  ledgerId     String
  userId       String
  /// 'lend'=借出(应收) | 'borrow'=借入(应付)
  direction    String
  amount       Decimal   @db.Decimal(15, 2)
  /// 已还/已收金额
  repaidAmount Decimal   @default(0) @db.Decimal(15, 2)
  /// 出/入款账户（可空）
  accountId    String?
  /// 备注密文（base64，账本 DEK 加密）
  noteCipher   String?
  noteDekVer   Int       @default(1)
  /// 凭证图片 key
  voucherKey   String?
  date         DateTime
  /// 结清时间（已还=本金时置上）
  settledAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([ledgerId, direction, settledAt])
  @@index([ledgerId, createdAt])
}

/// 用户的股票持仓（每用户每股票一条），用于算总收益/当日收益。
model StockHolding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  /// 买入均价
  buyPrice  Float
  /// 持有数量（股）
  shares    Float
  /// 关联账本（建账单/找账户用）。null = 未关联，不自动结算
  ledgerId  String?
  /// 关联账户（投资类）：每日按最新价更新其余额、记当日盈亏流水
  accountId String?
  /// 上次结算用的价格（算当日 delta 的基准）。null = 尚未建立基准
  lastPrice Float?
  /// 上次成功结算的时间（幂等/补算判断：同一天只算一次）
  lastCalcAt DateTime?
  /// 每日 AI 持仓决策（JSON: {action, reason}），随每日结算生成
  advice    String?
  adviceAt  DateTime?
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
}

/// 每日选股运行记录（一交易日一条）：强势板块 + 市场解读
model DailyPickRun {
  id        String   @id @default(cuid())
  tradeDate String   @unique // yyyy-MM-dd
  boards    String // JSON: [{name, pct, amount, lead}] 强势板块
  comment   String? // 市场/板块解读（LLM）
  picks     DailyPick[]
  createdAt DateTime @default(now())
}

/// 每日机会股（每交易日 Top N）
model DailyPick {
  id            String   @id @default(cuid())
  tradeDate     String // yyyy-MM-dd
  runId         String
  run           DailyPickRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rank          Int // 1..N
  code          String // 6 位代码
  symbol        String // 带市场前缀，如 sh600176
  name          String
  boardName     String // 所属强势板块
  price         Float?
  changePercent Float?
  pe            Float?
  pb            Float?
  score         Int // AI 机会评分 0-100
  action        String // 合规措辞：重点关注/逢低关注/观望 等
  reason        String // 入选理由
  risk          String // 主要风险
  // —— 复盘：推荐后用最新价回测的实际表现（学习闭环用）——
  lastPrice     Float? // 最近一次评估时的价
  outcomePct    Float? // 自推荐以来累计收益 %
  outcomeAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([tradeDate, code])
  @@index([tradeDate, rank])
}

/// 选股 agent 的「记忆」：自我进化的策略备忘 + 最近战绩快照（单行，每日更新）
model PicksMemory {
  id        String   @id @default("default")
  playbook  String   @default("") // 累积的经验/策略(LLM 每日复盘后更新)
  stats     String? // JSON: 样本数/胜率/平均收益/分动作命中等
  updatedAt DateTime @updatedAt
}
