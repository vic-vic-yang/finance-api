generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 账单类型：收入 / 支出
enum BillType {
  income
  expense
}

/// 账户类型：区分现金/银行卡/虚拟账户/信用卡/投资/社保/负债等
enum AccountType {
  CASH // 现金
  BANK // 银行卡（储蓄卡/借记卡/存折）
  VIRTUAL // 虚拟账户（微信/支付宝/电子钱包等）
  CREDIT // 信用卡
  INVESTMENT // 投资理财（理财 / 股票 / 基金 / 债券）
  INSURANCE // 社保（社保 / 公积金 / 保险）
  DEBT // 负债账户（房贷 / 车贷 / 借款）
  OTHER // 其他
  // ─── 历史保留（PG 不能干净地删 enum 值，仅用于读取旧数据）───
  ALIPAY
  WECHAT
}

/// 预算周期：月度 / 年度
enum BudgetPeriod {
  MONTHLY
  YEARLY
}

/// 账本角色：owner（拥有者） / member（成员）
enum LedgerRole {
  owner
  member
}

/// AI 导入状态机：从上传到入库的完整生命周期
enum AiImportStatus {
  pending // 已上传，待处理
  extracting // 提取文件内容（OCR / 解 CSV / 读 PDF）
  parsing // LLM 解析中
  dedupping // 去重中
  review_ready // 草稿就绪，等客户端拉取加密入库
  applying // 客户端正在批量加密入库
  done
  failed
  partial // 部分成功
}

/// 用户表：注册/登录/端到端加密密钥对/VIP/角色管理的核心实体
model User {
  id              String         @id @default(cuid())
  username        String         @unique
  /// 用户昵称，显示用；为空时回退到 username
  nickname        String?
  /// 角色：user / admin（admin 可进管理后台、天然享受服务端默认 AI）
  role            String         @default("user")
  /// VIP 等级：free / vip（预留扩展：pro / premium…）。VIP 可用服务端默认 AI 配置
  vipTier         String         @default("free")
  /// VIP 到期时间；null = 永久（tier 非 free 时）
  vipExpiresAt    DateTime?
  /// VIP 备注（来源：手动开通 / 活动 / 付费单号…）
  vipNote         String?
  /// bcrypt 密码哈希（12 rounds）
  password        String
  createdAt       DateTime       @default(now())
  /// 当前活动账本 ID
  currentLedgerId String?
  currentLedger   Ledger?        @relation("CurrentLedger", fields: [currentLedgerId], references: [id], onDelete: SetNull)
  ownedLedgers    Ledger[]       @relation("OwnedLedgers")
  ledgerMembers   LedgerMember[]
  bills           Bill[] // 创建者，便于追踪是谁记的
  categories      Category[] // 用户自建分类（系统分类 userId=null）
  ownedAccounts   Account[]      @relation("AccountOwner")
  aiImports       AiImport[]     @relation("UserAiImports")

  // ── 国密 SM2 用户密钥对（端到端加密基础）───────────────────
  /// SM2 公钥（hex 字符串，未压缩 04|x|y 共 130 个字符）
  sm2PubKey         String?
  /// SM2 私钥用 KDF(密码) 派生的 SM4 密钥加密后的字节流（iv||ct||mac）
  sm2PrivByPwd      Bytes?
  /// SM2 私钥用 KDF(恢复码) 派生的 SM4 密钥加密后的字节流（找回密钥用）
  sm2PrivByRecovery Bytes?
  /// 派生 KEK 用的 salt（密码 + 恢复码共用同一个 salt，简化客户端逻辑）
  kdfSalt           Bytes?
  /// 恢复码 SM3(code || salt) 哈希，用于"忘密码 → 验证恢复码"
  recoveryHash      Bytes?
}

/// 账本：个人或共享的财务管理容器，拥有自己的账户/分类/账单/预算/成员体系
model Ledger {
  id         String          @id @default(cuid())
  /// 账本名称
  name       String
  /// 账本图标（emoji）
  icon       String?
  /// 拥有者用户 ID
  ownerId    String
  owner      User            @relation("OwnedLedgers", fields: [ownerId], references: [id], onDelete: Cascade)
  /// true=个人默认账本，注册时自动创建，不可删除/退出
  isPersonal Boolean         @default(false)
  createdAt  DateTime        @default(now())
  members    LedgerMember[]
  invites    LedgerInvite[]
  accounts   Account[]
  bills      Bill[]
  budgets    Budget[]
  categories Category[]
  currentFor User[]          @relation("CurrentLedger")
  aiImports  AiImport[]      @relation("LedgerAiImports")
  recurring  RecurringBill[]
  proposals  Proposal[]

  @@index([ownerId])
}

/// 账本成员：记录成员角色、DEK 信封加密数据
model LedgerMember {
  id       String     @id @default(cuid())
  ledgerId String
  ledger   Ledger     @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     LedgerRole @default(member)
  joinedAt DateTime   @default(now())

  // ── 信封加密：该账本 DEK 用该成员公钥 SM2 包装后的密文 ──
  /// 包装后的 DEK；新成员通过邀请码加入后此处先为 null，
  /// 由任意已持有 DEK 的在线成员客户端检测到后自动 wrap & 上传
  dekWrapped Bytes?
  /// DEK 版本号，支持密钥轮换（v2 起所有成员需重新 wrap）
  dekVersion Int    @default(1)

  @@unique([ledgerId, userId])
  @@index([userId])
}

/// 账本邀请码：6 位唯一码，供其他用户扫描加入共享账本
model LedgerInvite {
  id        String    @id @default(cuid())
  ledgerId  String
  ledger    Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  /// 6 位唯一邀请码
  code      String    @unique
  /// 创建者用户 ID
  createdBy String
  /// 过期时间
  expiresAt DateTime
  /// 使用该邀请码加入的用户 ID
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ledgerId])
}

/// 账户：账本下的资金账户，支持信用卡/负债/自动入账等多种类型
model Account {
  id             String          @id @default(cuid())
  ledgerId       String
  ledger         Ledger          @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  /// 账户所有者：null = 共享账户（账本内所有成员可用）；非空 = 私人账户（仅本人可见可用）
  ownerId        String?
  owner          User?           @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// 账户名密文（SM4-CBC + SM3-HMAC, iv||ct||mac 一体）。
  /// 服务端永不解密；客户端用账本 DEK 解。
  nameCipher     Bytes
  /// 加密时使用的 DEK 版本（用于密钥轮换）
  nameDekVer     Int             @default(1)
  type           AccountType
  /// 当前余额（Decimal 15,2 精度）
  balance        Decimal         @default(0) @db.Decimal(15, 2)
  /// 初始余额（建账时录入；老账户由 当前余额 − 历史净收支 回填）
  initialBalance Decimal         @default(0) @db.Decimal(15, 2)
  /// 图标（emoji）
  icon           String?
  /// 颜色（hex）
  color          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bills          Bill[]
  recurring      RecurringBill[]
  goals          SavingsGoal[]

  // ── 信用卡专用 ─────────────────────────────────────────────
  /// 账单日（1-31）：每月这一天出账
  statementDay Int?
  /// 还款日（1-31）：每月这一天前需还款
  dueDay       Int?
  /// 信用额度（可选，仅信用卡使用，用于显示"已用 / 总额度"）
  creditLimit  Decimal? @db.Decimal(15, 2)

  // ── 负债账户专用 ──────────────────────────────────────────
  /// 年利率（%），如 5.4 表示 5.4%；dueDay 复用为月还款日
  interestRate     Decimal?  @db.Decimal(6, 3)
  /// 贷款本金（原始金额）
  loanPrincipal    Decimal?  @db.Decimal(15, 2)
  /// 贷款期限（月）
  loanTermMonths   Int?
  /// 首次还款日期（用于计算已还期数）
  firstPaymentDate DateTime?
  /// 还款方式：equal_payment(等额本息) / equal_principal(等额本金) / interest_only(先息后本)
  repaymentMethod  String?

  // ── 自动入账（社保 / 公积金 / 工资固定到账）专用 ─────────
  /// 每月自动入账日（1-31）
  autoDepositDay        Int?
  /// 每月自动入账金额（正数）
  autoDepositAmount     Decimal?  @db.Decimal(15, 2)
  /// 自动入账记入哪个分类（可选；为空时后端用"其他收入"系统分类）
  autoDepositCategoryId String?
  /// 自动入账上次处理到的日期（用于补漏，不依赖定时任务）
  lastAutoProcessedAt   DateTime?

  @@index([ledgerId])
  @@index([ownerId])
}

/// 分类：系统全局分类 + 账本自定义分类，支持二级层级
model Category {
  id        String   @id @default(cuid())
  /// null = 系统分类（全局共享，所有账本可见）
  ledgerId  String?
  ledger    Ledger?  @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  /// 创建者用户 ID；null = 系统分类
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 分类名称
  name      String
  /// 类型：income / expense
  type      BillType
  /// 图标（emoji）
  icon      String?
  /// 颜色（hex）
  color     String?
  /// 是否为系统预置分类
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  // —— 二级分类支持：parentId 为空 = 一级分类 ——
  /// 父分类 ID（null=一级分类）
  parentId String?
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryChildren")

  bills     Bill[]
  budgets   Budget[]
  recurring RecurringBill[]

  @@index([ledgerId])
  @@index([parentId])
}

/// 账本共享的 LLM 配置（BYOK）：一名成员配置并共享后，本账本所有成员的
/// AI 功能都用这份配置调用。apiKeyEnc 用服务端密钥 AES-256-GCM 加密落库。
model LedgerLlmConfig {
  id            String   @id @default(cuid())
  /// 关联账本（每账本最多一条配置）
  ledgerId      String   @unique
  /// 配置者用户 ID（只有此人可改/删）
  ownerUserId   String
  /// 服务商：deepseek / qwen / kimi / glm / custom
  provider      String   @default("custom")
  /// API 端点地址
  baseUrl       String
  /// 文本模型名
  modelId       String
  /// 视觉模型名（可选）
  visionModelId String?
  /// AES-256-GCM 加密后的 API Key
  apiKeyEnc     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerUserId])
}

/// 分类自定义排序：记录每个账本对分类的排序顺序，覆盖全局默认顺序
model CategorySort {
  id         String   @id @default(cuid())
  ledgerId   String
  categoryId String
  /// 排序序号（越小越靠前）
  sortOrder  Int
  createdAt  DateTime @default(now())

  @@unique([ledgerId, categoryId])
  @@index([ledgerId])
}

/// 账单流水：每笔收入/支出/转账的记录，余额联动核心实体
model Bill {
  id           String   @id @default(cuid())
  ledgerId     String
  ledger       Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  /// 记账用户 ID（多账本时显示"谁记的"）
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 关联账户 ID
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  /// 关联分类 ID
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  /// 类型：income / expense
  type         BillType
  /// 金额（正数，Decimal 15,2）
  amount       Decimal  @db.Decimal(15, 2)
  /// 备注密文（SM4-CBC + SM3-HMAC, iv||ct||mac 一体）。
  /// 空备注也加密为一个固定密文（避免空字段泄露"无备注"信息）
  noteCipher   Bytes
  /// 加密所用 DEK 版本
  noteDekVer   Int      @default(1)
  /// 交易日期
  date         DateTime
  /// 平台交易订单号（支付宝/微信），用于同源稳健去重；非平台来源为 null
  externalId   String?
  /// 来源渠道：alipay / wechat / bank / manual
  source       String   @default("manual")
  /// 是否为转账账单（账户间转账拆成的一收一支）。转账不计入收支统计/预算，但在账单列表可见。
  isTransfer   Boolean  @default(false)
  /// 银行流水的「联机余额」（该笔交易后的账户余额）。仅银行类导入有；
  /// 用作高精度去重的天然唯一键，最新一笔还可用来校准账户余额。
  bankBalance  Decimal? @db.Decimal(15, 2)
  /// 导入流水的商户名哈希（sha256(规整后商户名)，不存明文）。
  /// 用户改这笔账单的分类时借它记住"该商户 → 分类"，下次导入自动套用。
  merchantHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ledgerId, date(sort: Desc)])
  @@index([ledgerId, externalId])
  @@index([ledgerId, accountId, date])
}

/// 分类纠正记忆：商户(哈希) → 用户手动修正的分类。
/// AI 导入解析时优先查这里，实现"用户修正一次，以后都对"。
model CategoryCorrection {
  id           String   @id @default(cuid())
  ledgerId     String
  /// 商户名 SHA256 哈希
  merchantHash String
  /// 用户手动指定的分类 ID
  categoryId   String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([ledgerId, merchantHash])
  @@index([ledgerId])
}

/// AI 导入记录：文件上传后的处理状态机，含草稿/去重统计/LLM 原始输出
model AiImport {
  id       String @id @default(cuid())
  ledgerId String
  ledger   Ledger @relation("LedgerAiImports", fields: [ledgerId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("UserAiImports", fields: [userId], references: [id], onDelete: Cascade)

  // 文件
  /// 原始文件名
  filename String
  /// 文件类型：image / pdf / csv / xlsx / text
  fileType String
  /// 文件大小（字节）
  fileSize Int

  /// 用户上传时选定的目标账户（所有解析出的草稿都入到这个账户）
  accountId String

  /// AI 模型名
  modelName String

  // 状态
  status   AiImportStatus @default(pending)
  /// 进度百分比（0-100）
  progress Int            @default(0)
  /// 当前阶段说明或失败原因（简短）
  message  String?

  // 统计
  /// AI 解析出多少条
  parsedCount   Int @default(0)
  /// 去重跳过多少条
  dupCount      Int @default(0)
  /// 实际入库多少条
  insertedCount Int @default(0)

  // 草稿 + 调试（明文暂存，apply 完成后清空）
  /// 明文草稿 JSON 数组（apply 后清空）
  draftsJson String?
  /// LLM 原始返回文本（方便排查）
  rawOutput  String?
  /// 失败时的完整错误栈
  errorTrace String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([ledgerId, status])
}

/// 预算：按分类设月度/年度预算上限，跟踪执行进度
model Budget {
  id         String       @id @default(cuid())
  ledgerId   String
  ledger     Ledger       @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  /// 关联分类 ID（null=总预算）
  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id])
  /// 预算金额（上限）
  amount     Decimal      @db.Decimal(15, 2)
  /// 周期：MONTHLY / YEARLY
  period     BudgetPeriod
  /// 周期起始日期
  startDate  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([ledgerId])
}

/// 周期账单（房租 / 会员订阅 / 话费 …）
/// 可由 AI 从历史账单识别（isAuto=true）也可手动添加。
model RecurringBill {
  id         String   @id @default(cuid())
  ledgerId   String
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  type       BillType @default(expense)
  amount     Decimal  @db.Decimal(15, 2)
  /// 备注密文（同 Bill.noteCipher 格式）
  noteCipher Bytes?
  noteDekVer Int?
  /// 周期类型：monthly / weekly / yearly
  cycleType  String   @default("monthly")
  /// 几号（月度）或 周几（周度，1-7）或 mmdd（年度）
  cycleDay   Int
  /// 下次触发生成账单的日期（服务端计算）
  nextDate   DateTime
  /// 是否启用
  isActive   Boolean  @default(true)
  /// true = AI 自动发现的候选；用户确认后置 false（变成手动维护）
  isAuto     Boolean  @default(false)
  /// 识别置信度 0-1
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ledgerId, isActive])
  @@index([nextDate])
}

/// 储蓄目标：设定目标金额和期限，可绑定账户自动计算进度
model SavingsGoal {
  id             String    @id @default(cuid())
  userId         String
  ledgerId       String
  /// 目标名称密文（SM4-CBC + SM3-HMAC, iv||ct||mac）
  nameCipher     Bytes
  nameDekVer     Int       @default(1)
  /// 目标金额
  targetAmount   Decimal   @db.Decimal(15, 2)
  /// 起算日：从这天起的（收入-支出）算作已存（未绑定账户时使用）
  startDate      DateTime  @default(now())
  /// 绑定的账户 ID：不为空时用账户余额自动计算进度
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// 绑定账户时的初始余额快照。0 = 计入现有余额；> 0 = 从零开始（只算增量）
  initialBalance Decimal?  @db.Decimal(15, 2)
  /// 期望达成日（可空）
  deadline       DateTime?
  icon           String?
  color          String?
  /// 是否已完成
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, ledgerId])
}

/// AI 洞察的"已忽略"记录：持久化用户对某条洞察的忽略状态，
/// 同 (type, target) 在 expireAt 前不再出现
model AiInsightDismissal {
  id          String   @id @default(cuid())
  userId      String
  ledgerId    String
  /// 洞察类型：anomaly_cat / anomaly_bill / budget_alert / recurring_due / trend_up / trend_down …
  type        String
  /// 关联对象 ID（categoryId / billId / budgetId / recurringId 等）
  target      String
  dismissedAt DateTime @default(now())
  /// 忽略到期时间（过期后如果条件仍成立会再次浮出）
  expireAt    DateTime

  @@unique([userId, ledgerId, type, target])
  @@index([userId, ledgerId])
  @@index([expireAt])
}

/// CFO 建议提案：检测器发现问题后生成的待处理建议，支持审批/忽略/稍后/执行
model Proposal {
  id             String    @id @default(cuid())
  ledgerId       String
  ledger         Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  /// 检测器类型：recategorize_other / large_expense / overspend / idle_to_goal / duplicate
  type           String
  /// 状态：pending / approved / dismissed / snoozed / done / expired
  status         String    @default("pending")
  /// 严重级别：info / warning / critical
  severity       String    @default("warning")
  /// 提案标题
  title          String
  /// 提案详细说明
  body           String
  /// 执行动作类型（如 adjust_budget / recategorize_bill / delete_bill）
  actionKind     String?
  /// 执行动作参数（JSON）
  actionParams   Json?
  /// 是否需要客户端参与执行（如 allocate_to_goal）
  requiresClient Boolean   @default(false)
  /// 证据引用（相关账单/预算的 ID 列表，JSON）
  evidenceRefs   Json?
  /// 去重键：同 (ledgerId, dedupeKey) 不重复生成
  dedupeKey      String
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@unique([ledgerId, dedupeKey])
  @@index([ledgerId, status])
}

/// CFO 学习反馈：某类型建议被忽略≥3 次后自动静音 30 天
model ProposalFeedback {
  id         String    @id @default(cuid())
  ledgerId   String
  /// 检测器类型
  type       String
  /// 被忽略次数
  dismissed  Int       @default(0)
  /// 被批准次数
  approved   Int       @default(0)
  /// 静音截止时间（null=未静音）
  mutedUntil DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([ledgerId, type])
}

/// 每日财经新闻：RSS 聚合 + LLM 富化结果，全局共享，按 url 去重
model NewsArticle {
  id          String   @id @default(cuid())
  /// 原标题
  title       String
  /// LLM 翻译的中文标题（列表/详情主标题用）；无 LLM 时回退原标题
  titleZh     String?
  /// LLM 中文摘要；无 LLM 时回退 RSS 原始描述
  summary     String?
  /// 来源名（CNBC / MarketWatch / 新浪财经 …）
  source      String
  /// 原文链接（唯一，跨日去重用）
  url         String   @unique
  imageUrl    String?
  /// 标签：股市 / 宏观 / 加密 / 科技 / 政策 …（LLM 分类）
  category    String?
  /// 重要性评分 0-100（LLM 给，用于排序）
  importance  Int      @default(0)
  /// 情绪：positive / neutral / negative
  sentiment   String?
  /// 抓取的原文正文（纯文本，懒加载，用户打开详情时才抓）
  content     String?
  /// LLM 基于正文提炼的要点分析（懒加载，打开详情时生成并缓存）
  analysis    String?
  /// 原文发布时间
  publishedAt DateTime
  /// 抓取时间
  fetchedAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([importance])
}

/// 股票 AI 分析快照：用户查询过的股票分析结果，每次查询存一条
model StockAnalysis {
  id        String   @id @default(cuid())
  userId    String
  /// 股票代码（如 AAPL / 600176）
  symbol    String
  name      String?
  nameZh    String?
  /// 查询时的关键指标快照（价格/市值/PE/评级/目标价…）
  quote     Json
  /// LLM 分析文本
  analysis  String?
  /// 相关新闻快照
  news      Json?
  createdAt DateTime @default(now())

  @@index([userId, symbol, createdAt])
  @@index([userId, createdAt])
}

/// 借贷往来：借出(别人欠我/应收) / 借入(我欠别人/应付)
model Loan {
  id           String          @id @default(cuid())
  ledgerId     String
  userId       String
  /// 'lend'=借出(应收) | 'borrow'=借入(应付)
  direction    String
  /// 本金金额
  amount       Decimal         @db.Decimal(15, 2)
  /// 已还/已收金额
  repaidAmount Decimal         @default(0) @db.Decimal(15, 2)
  /// 出/入款账户 ID（可空）
  accountId    String?
  /// 备注密文（base64，账本 DEK 加密）
  noteCipher   String?
  noteDekVer   Int             @default(1)
  /// 凭证图片 key（uploads 模块）
  voucherKey   String?
  /// 借贷发生日期
  date         DateTime
  /// 结清时间（已还=本金时置上）
  settledAt    DateTime?
  createdAt    DateTime        @default(now())
  /// 还款记录
  repayments   LoanRepayment[]

  @@index([ledgerId, direction, settledAt])
  @@index([ledgerId, createdAt])
}

/// 还款/收款记录：借贷往来的还款流水
model LoanRepayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  /// 本次还款金额
  amount    Decimal  @db.Decimal(15, 2)
  /// 对应账单 ID（如果有）
  billId    String?
  date      DateTime
  createdAt DateTime @default(now())

  @@index([loanId])
}

/// 用户股票持仓：每用户每股票一条，含成本/数量/关联账户
model StockHolding {
  id         String    @id @default(cuid())
  userId     String
  /// 股票代码
  symbol     String
  /// 买入均价
  buyPrice   Float
  /// 持有数量（股）
  shares     Float
  /// 关联账本（建账单/找账户用）。null = 未关联，不自动结算
  ledgerId   String?
  /// 关联账户（投资类）：每日按最新价更新其余额、记当日盈亏流水
  accountId  String?
  /// 上次结算用的价格（算当日 delta 的基准）。null = 尚未建立基准
  lastPrice  Float?
  /// 上次成功结算的时间（幂等/补算判断：同一天只算一次）
  lastCalcAt DateTime?
  /// 每日 AI 持仓决策（JSON: {action, reason}），随每日结算生成
  advice     String?
  adviceAt   DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([userId, symbol])
}

/// 每日选股运行记录：一交易日一条，含强势板块 + 市场解读
model DailyPickRun {
  id        String      @id @default(cuid())
  /// 交易日（yyyy-MM-dd）
  tradeDate String      @unique
  /// 强势板块 JSON 数组
  boards    String
  /// 市场/板块解读（LLM）
  comment   String?
  picks     DailyPick[]
  createdAt DateTime    @default(now())
}

/// 每日机会股：每交易日 Top N 精选，含评分/理由/风险/复盘回测
model DailyPick {
  id            String       @id @default(cuid())
  /// 交易日（yyyy-MM-dd）
  tradeDate     String
  runId         String
  run           DailyPickRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 排名 1..N
  rank          Int
  /// 6 位代码
  code          String
  /// 带市场前缀代码，如 sh600176
  symbol        String
  /// 股票名称
  name          String
  /// 所属强势板块名
  boardName     String
  price         Float?
  changePercent Float?
  pe            Float?
  pb            Float?
  /// AI 机会评分 0-100
  score         Int
  /// 合规措辞：重点关注/逢低关注/观望 等
  action        String
  /// 入选理由
  reason        String
  /// 主要风险
  risk          String
  // —— 复盘：推荐后用最新价回测的实际表现（学习闭环用）——
  /// 最近一次评估时的价格
  lastPrice     Float?
  /// 自推荐以来累计收益 %
  outcomePct    Float?
  outcomeAt     DateTime?
  createdAt     DateTime     @default(now())

  @@unique([tradeDate, code])
  @@index([tradeDate, rank])
}

/// 选股 agent 的「记忆」：自我进化的策略备忘 + 最近战绩快照（单行，每日更新）
model PicksMemory {
  id        String   @id @default("default")
  /// 累积的经验/策略（LLM 每日复盘后更新）
  playbook  String   @default("")
  /// JSON: 样本数/胜率/平均收益/分动作命中等
  stats     String?
  updatedAt DateTime @updatedAt
}
