# 司库生产 Nginx 示例
# 完整的 API、Admin、官网与安全头配置以 siku.production.conf 为准。
# 建议部署路径：/etc/nginx/conf.d/siku.conf

server {
    listen 80;
    listen [::]:80;
    server_name www.equitick.top;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        allow all;
        try_files $uri =404;
    }

    location / {
        return 301 https://www.equitick.top$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.equitick.top;

    ssl_certificate /etc/letsencrypt/live/www.equitick.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.equitick.top/privkey.pem;

    root /opt/siku/website;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        allow all;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

# 首次签发或切换为 webroot 验证：
# mkdir -p /var/www/certbot/.well-known/acme-challenge
# certbot certonly --webroot -w /var/www/certbot -d www.equitick.top --non-interactive --agree-tos -m <运维邮箱>
#
# 自动续期检查：
# systemctl status certbot-renew.timer
# certbot renew --dry-run
#
# API/Admin 的 finance.equitick.top 配置见 siku.production.conf：
# /api/   -> 127.0.0.1:3000
# /admin/ -> 127.0.0.1:3001
